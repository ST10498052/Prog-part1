@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
}

<div class="rd-pagehead">
    <h1 class="rd-title">My results</h1>
</div>

@if (ViewBag.Error is string loadError)
{
    <div class="alert alert-danger">@loadError</div>
}

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <h2>No results yet</h2>
        <p>Your race history will appear here once an organiser has captured your result after an event.</p>
    </div>
}
else
{
    <div class="rd-panel p-0">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.EventName</td>
                            <td>@Ui.Date(r.EventDate)</td>
                            <td>@r.CategoryName</td>
                            <td class="rd-time">@Ui.Time(r.FinishTime)</td>
                            <td>@Ui.PositionText(r)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
