@model EventListViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="rd-hero">
    <h1>Find your next race</h1>
    <p>Browse upcoming runs, walks and rides, then enter in a couple of clicks.</p>
</section>

<form method="get" class="rd-filter row g-2 align-items-end">
    <div class="col-md-4">
        <label for="location" class="form-label">Location</label>
        <input type="text" id="location" name="location" value="@Model.Location" class="form-control" placeholder="e.g. Cape Town" />
    </div>
    <div class="col-md-3">
        <label for="eventType" class="form-label">Event type</label>
        <select id="eventType" name="eventType" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(Model.EventType))">All types</option>
            <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
            <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
            <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="from" class="form-label">From date</label>
        <input type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Events.Count == 0)
{
    <div class="rd-empty">
        <h2>No events match your filters</h2>
        <p>Try a different location, type or date.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
