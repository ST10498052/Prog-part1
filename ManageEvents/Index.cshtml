@model List<EventDto>
@{
    ViewData["Title"] = "My events";
}

<div class="rd-pagehead">
    <h1 class="rd-title">My events</h1>
    <a class="btn btn-primary" asp-action="Create">+ New event</a>
</div>

@if (ViewBag.Error is string loadError)
{
    <div class="alert alert-danger">@loadError</div>
}

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <h2>No events yet</h2>
        <p>Create an event to get started.</p>
    </div>
}
else
{
    <div class="rd-panel p-0">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Distance</th>
                        <th>Status</th>
                        <th class="text-end">Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(e.BannerImage))
                                    {
                                        <img src="@Ui.ImageUrl(e.BannerImage)" alt="" class="rd-thumb" />
                                    }
                                    else
                                    {
                                        <div class="rd-thumb rd-placeholder"></div>
                                    }
                                    <div>
                                        <div class="fw-semibold">@e.Name</div>
                                        <div class="text-muted small">@e.Location</div>
                                    </div>
                                </div>
                            </td>
                            <td>@Ui.Date(e.EventDate)</td>
                            <td>@Ui.TypeBadge(e.EventType)</td>
                            <td>@Ui.Distance(e.DistanceKm)</td>
                            <td>@Ui.StatusBadge(e.Status)</td>
                            <td class="text-end fw-semibold">@e.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventId">Categories</a>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                                <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
