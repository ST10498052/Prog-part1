@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<a asp-action="Index" class="rd-back">&larr; My events</a>
<div class="rd-panel">
    <h1 class="rd-title">Edit event</h1>
    <form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
        <partial name="_EventForm" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
