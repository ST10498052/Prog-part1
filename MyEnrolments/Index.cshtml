@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}

<div class="rd-pagehead">
    <h1 class="rd-title">My enrolments</h1>
    <a class="btn btn-primary" asp-controller="Events" asp-action="Index">Find more events</a>
</div>

@if (ViewBag.Error is string loadError)
{
    <div class="alert alert-danger">@loadError</div>
}

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <h2>You haven't entered any events yet</h2>
        <p>Browse upcoming events and pick one that suits you.</p>
    </div>
}
else
{
    <div class="rd-panel p-0">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Bib</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a></td>
                            <td>@Ui.Date(e.EventDate)</td>
                            <td>@e.CategoryName</td>
                            <td>@e.BibNumber</td>
                            <td>@Ui.StatusBadge(e.DisplayStatus)</td>
                            <td class="text-end">
                                @if (e.DisplayStatus == "Confirmed" && e.EventDate > DateTime.Now)
                                {
                                    <form asp-action="Withdraw" asp-route-id="@e.EnrolmentId" method="post" class="d-inline" onsubmit="return confirm('Withdraw from this event?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
