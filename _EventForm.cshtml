@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CurrentBanner" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="150" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" maxlength="150" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="Draft">Draft (hidden from participants)</option>
            <option value="Published">Published</option>
            <option value="Cancelled">Cancelled</option>
            <option value="Completed">Completed</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label for="Banner" class="form-label">Banner image <span class="text-muted">(JPEG, PNG, GIF or WebP, up to 5 MB)</span></label>
        @if (!string.IsNullOrEmpty(Model.CurrentBanner))
        {
            <div class="mb-2">
                <img src="@Ui.ImageUrl(Model.CurrentBanner)" alt="Current banner" class="rd-banner-thumb" />
                <div class="form-text">Current banner. Choose a new file to replace it.</div>
            </div>
        }
        <input type="file" id="Banner" name="Banner" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" />
    </div>
</div>
